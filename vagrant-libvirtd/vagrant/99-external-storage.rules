# Match the serial values assigned by the libvirt storage declarations.
# ID_SERIAL_SHORT is provider-neutral and avoids hypervisor vendor strings.
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_SERIAL_SHORT}=="mgt_0000000000000000", SYMLINK+="mgt"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_SERIAL_SHORT}=="mdt1_000000000000000", SYMLINK+="mdt1"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_SERIAL_SHORT}=="mdt2_000000000000000", SYMLINK+="mdt2"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_SERIAL_SHORT}=="mdt3_000000000000000", SYMLINK+="mdt3"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_SERIAL_SHORT}=="OST1_000000000000000", SYMLINK+="ost1"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_SERIAL_SHORT}=="OST2_000000000000000", SYMLINK+="ost2"
